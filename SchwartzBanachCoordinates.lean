import SchwartzDerivativeCompleteness
import StrictQuotientStages
import LocalBanachSpaces

open Bornology Filter Function Set Topology TopologicalSpace UniformSpace
open scoped SchwartzMap Uniformity

namespace Masullo

noncomputable section

section Product

variable {I : Type*} {E : I → Type*}
  [∀ i, NormedAddCommGroup (E i)] [∀ i, NormedSpace ℂ (E i)]
  {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- A family of Schwartz maps with its pointwise values in a given subspace. -/
def schwartzIntoSubmodule (K : Submodule ℂ (∀ i, E i)) :
    Submodule ℂ (∀ i, 𝓢(X, E i)) where
  carrier := {f | ∀ x : X, (fun i => f i x) ∈ K}
  zero_mem' := fun _ => K.zero_mem
  add_mem' := fun hf hg x => K.add_mem (hf x) (hg x)
  smul_mem' := fun a _ hf x => K.smul_mem a (hf x)

/-- The coordinatewise model is equivalent to functions valued in the
subspace whose components are Schwartz maps. -/
def schwartzIntoSubmodule_equiv (K : Submodule ℂ (∀ i, E i)) :
    ↥(schwartzIntoSubmodule (X := X) K) ≃
      {φ : X → K // ∀ i, ∃ f : 𝓢(X, E i), ∀ x, f x = (φ x).val i} := by
  classical
  let B := {φ : X → K // ∀ i, ∃ f : 𝓢(X, E i), ∀ x, f x = (φ x).val i}
  let J : schwartzIntoSubmodule (X := X) K → B := fun f =>
    ⟨fun x => ⟨fun i => f.val i x, f.property x⟩, fun i => ⟨f.val i, fun _ => rfl⟩⟩
  refine Equiv.ofBijective J ⟨?_, ?_⟩
  · intro f g h
    apply Subtype.ext
    funext i
    apply SchwartzMap.ext
    intro x
    exact congrArg (fun φ : B => (φ.val x).val i) h
  · intro φ
    let f (i : I) := (φ.property i).choose
    have hf (x : X) : (fun i => f i x) = (φ.val x).val :=
      funext fun i => (φ.property i).choose_spec x
    refine ⟨⟨f, fun x => hf x |>.symm ▸ (φ.val x).property⟩, ?_⟩
    apply Subtype.ext
    funext x
    exact Subtype.ext (hf x)

/-- The pointwise value constraints are closed for the derivative topology. -/
theorem isClosed_schwartzIntoSubmodule (K : Submodule ℂ (∀ i, E i))
    (hK : IsClosed (K : Set (∀ i, E i))) :
    IsClosed (schwartzIntoSubmodule (X := X) K : Set (∀ i, 𝓢(X, E i))) := by
  have he : (schwartzIntoSubmodule (X := X) K : Set (∀ i, 𝓢(X, E i))) =
      ⋂ x : X, (fun f : ∀ i, 𝓢(X, E i) => fun i => f i x) ⁻¹' K := by
    ext f
    change (∀ x : X, (fun i => f i x) ∈ K) ↔ _
    rw [mem_iInter]
    rfl
  rw [he]
  exact isClosed_iInter fun x => hK.preimage (continuous_pi fun i =>
    (((BoundedContinuousFunction.evalCLM ℂ x).comp
      (SchwartzMap.toBoundedContinuousFunctionCLM ℂ X (E i))).continuous).comp
      (continuous_apply i))

/-- The inherited topology is generated by the weighted derivative seminorms
of each Banach coordinate. -/
theorem schwartzIntoSubmodule_withSeminorms (K : Submodule ℂ (∀ i, E i)) :
    WithSeminorms
      ((SeminormFamily.sigma (fun i =>
        (schwartzSeminormFamily ℂ X (E i)).comp (LinearMap.proj i))).comp
        (schwartzIntoSubmodule (X := X) K).subtype) :=
  (schwartzIntoSubmodule (X := X) K).subtype.withSeminorms_induced
    (withSeminorms_pi fun i => schwartz_withSeminorms ℂ X (E i))

variable [∀ i, CompleteSpace (E i)]

/-- A closed subspace of a product of complex Banach spaces gives a complete
space of Schwartz maps in the coordinate derivative topology. -/
theorem completeSpace_schwartzIntoSubmodule
    (K : Submodule ℂ (∀ i, E i)) (hK : IsClosed (K : Set (∀ i, E i))) :
    CompleteSpace (schwartzIntoSubmodule (X := X) K) := by
  letI : ∀ i, CompleteSpace 𝓢(X, E i) := fun _ => completeSpace_schwartzMap
  exact (isClosed_schwartzIntoSubmodule (X := X) K hK).isComplete.completeSpace_coe

/-- Countable products give a Fréchet space in the same topology. -/
theorem isFrechetTVS_schwartzIntoSubmodule [Countable I]
    (K : Submodule ℂ (∀ i, E i)) (hK : IsClosed (K : Set (∀ i, E i))) :
    IsFrechetTVS (schwartzIntoSubmodule (X := X) K) := by
  let P := ∀ i, 𝓢(X, E i)
  letI : ∀ i, CompleteSpace 𝓢(X, E i) := fun _ => completeSpace_schwartzMap
  letI : ∀ i, (uniformity 𝓢(X, E i)).IsCountablyGenerated := fun _ =>
    IsUniformAddGroup.uniformity_countably_generated
  letI : (𝓤 P).IsCountablyGenerated := inferInstanceAs ((𝓤 (∀ i, 𝓢(X, E i))).IsCountablyGenerated)
  have hP : IsFrechetTVS P := by
    refine ⟨inferInstance,
      (withSeminorms_pi (fun i => schwartz_withSeminorms ℂ X (E i))).toPolynormableSpace,
      UniformSpace.metrizableSpace, ?_⟩
    rw [IsUniformAddGroup.rightUniformSpace_eq]
    infer_instance
  exact isFrechetTVS_closedSubmodule hP _ (isClosed_schwartzIntoSubmodule K hK)

private def schwartzProductEval (x : X) : (∀ i, 𝓢(X, E i)) →L[ℂ] (∀ i, E i) :=
  ContinuousLinearMap.pi fun i => ((BoundedContinuousFunction.evalCLM ℂ x).comp
    (SchwartzMap.toBoundedContinuousFunctionCLM ℂ X (E i))).comp
    (ContinuousLinearMap.proj i)

private def schwartzSubmoduleEval (K : Submodule ℂ (∀ i, E i)) (x : X) :
    schwartzIntoSubmodule (X := X) K →L[ℂ] K := by
  let M := schwartzIntoSubmodule (X := X) K
  exact ((schwartzProductEval x).comp M.subtypeL).codRestrict K (fun f => f.property x)

/-- Quasi-completeness of the target subspace is sufficient for quasi-completeness
of the coordinatewise Schwartz space with the derivative topology. -/
theorem quasiComplete_schwartzIntoSubmodule
    (K : Submodule ℂ (∀ i, E i)) [QuasiCompleteSpace ℂ K] :
    QuasiCompleteSpace ℂ (schwartzIntoSubmodule (X := X) K) := by
  let P := ∀ i, 𝓢(X, E i)
  let M := schwartzIntoSubmodule (X := X) K
  letI : ∀ i, CompleteSpace 𝓢(X, E i) := fun _ => completeSpace_schwartzMap
  constructor
  intro S hS hClosed F hF hFS
  let j : M → P := Subtype.val
  have hj : IsUniformInducing j := isUniformEmbedding_subtype_val.isUniformInducing
  letI : IsUniformAddGroup M := IsUniformInducing.isUniformAddGroup M.subtype hj
  letI : IsUniformAddGroup K := IsUniformInducing.isUniformAddGroup K.subtype
    isUniformEmbedding_subtype_val.isUniformInducing
  letI : F.NeBot := hF.1
  have hJ : Cauchy (Filter.map j F) := hj.cauchy_map_iff.mpr hF
  obtain ⟨y, hy⟩ := CompleteSpace.complete hJ
  have hMem (x : X) : (fun i => y i x) ∈ K := by
    let v := schwartzSubmoduleEval (X := X) K x
    have hv : Cauchy (Filter.map v F) := hF.map v.uniformContinuous
    have hb : IsVonNBounded ℂ (closure (v '' S)) := (hS.image v).closure
    have hle : Filter.map v F ≤ Filter.principal (closure (v '' S)) := by
      refine (Filter.map_mono hFS).trans ?_
      rw [Filter.map_principal]
      exact Filter.principal_mono.mpr subset_closure
    obtain ⟨z, -, hz⟩ := QuasiCompleteSpace.quasiComplete hb isClosed_closure _ hv hle
    have h1 : Tendsto (fun f : M => ((v f : K) : ∀ i, E i)) F
        (𝓝 (z.val : ∀ i, E i)) :=
      continuous_subtype_val.continuousAt.tendsto.comp hz
    have h2 : Tendsto (fun f : M => ((v f : K) : ∀ i, E i)) F
        (𝓝 (fun i => y i x)) :=
      (schwartzProductEval (E := E) x).continuous.continuousAt.tendsto.comp hy
    have he := tendsto_nhds_unique h1 h2
    exact he ▸ z.property
  let z : M := ⟨y, hMem⟩
  have hz : Tendsto (id : M → M) F (𝓝 z) := tendsto_subtype_rng.mpr hy
  exact ⟨z, hClosed.mem_of_tendsto hz (hFS (mem_principal_self S)), hz⟩

end Product

section Canonical

variable {I Y : Type*} [AddCommGroup Y] [Module ℂ Y] [TopologicalSpace Y]
  {p : SeminormFamily ℂ Y I}

/-- The diagonal maps each vector to all its local Banach images. -/
def localBanachDiagonal (hp : WithSeminorms p) : Y →L[ℂ] (∀ i, LocalBanach (p i)) := by
  letI : IsTopologicalAddGroup Y := hp.topologicalAddGroup
  exact ⟨LinearMap.pi (fun i => localBanachDenseMap (p i)),
    continuous_pi fun i => (localBanachMap (p i) (hp.continuous_seminorm i)).continuous⟩

/-- The local Banach images induce the original locally convex topology. -/
theorem localBanachDiagonal_isInducing (hp : WithSeminorms p) :
    IsInducing (localBanachDiagonal hp) := by
  let K := ∀ i, LocalBanach (p i)
  let L := localBanachDiagonal hp
  let g : Y →ₗ[ℂ] K := L.toLinearMap
  let f : Y → K := g
  let t : TopologicalSpace Y := inferInstance
  have ht : @Continuous Y K t inferInstance f := L.continuous
  let s : TopologicalSpace Y := TopologicalSpace.induced f inferInstance
  have hs : @IsTopologicalAddGroup Y s _ := topologicalAddGroup_induced g
  have hi : @Continuous Y K s inferInstance f := continuous_induced_dom
  have hnorm (i : I) : @Continuous Y ℝ s inferInstance (p i) :=
    ((continuous_apply i).comp hi).norm.congr (norm_localBanachDenseMap (p i))
  have hEq : t = s := by
    apply le_antisymm <;> rw [← continuous_id_iff_le]
    · exact continuous_induced_rng.mpr ht
    · exact @WithSeminorms.continuous_of_continuous_comp ℂ ℂ Y Y I
        _ _ _ _ _ _ (RingHom.id ℂ) _ _ s hs t hp (LinearMap.id : Y →ₗ[ℂ] Y) hnorm
  exact @IsInducing.mk Y K t inferInstance f hEq

/-- A complete Hausdorff locally convex space is a closed linear subspace of
the product of its local Banach spaces. -/
theorem localBanachDiagonal_isClosedEmbedding [T0Space Y]
    (hp : WithSeminorms p) (hc : @CompleteSpace Y (@IsTopologicalAddGroup.rightUniformSpace Y _ _ hp.topologicalAddGroup)) :
    IsClosedEmbedding (localBanachDiagonal hp) := by
  letI : IsTopologicalAddGroup Y := hp.topologicalAddGroup
  letI : UniformSpace Y := IsTopologicalAddGroup.rightUniformSpace Y
  letI : IsUniformAddGroup Y := isUniformAddGroup_of_addCommGroup
  letI : CompleteSpace Y := hc
  let he : IsEmbedding (localBanachDiagonal hp) := (localBanachDiagonal_isInducing hp).isEmbedding
  exact (AddMonoidHom.isUniformEmbedding_of_isEmbedding he).isClosedEmbedding

/-- Quasi-completeness is preserved by the Banach diagonal onto its image. -/
theorem localBanachDiagonal_range_quasiComplete [T0Space Y]
    (hp : WithSeminorms p)
    (hQ : @QuasiCompleteSpace ℂ Y _ (@IsTopologicalAddGroup.rightUniformSpace Y _ _ hp.topologicalAddGroup)
      _ _) : QuasiCompleteSpace ℂ (localBanachDiagonal hp).range := by
  letI : IsTopologicalAddGroup Y := hp.topologicalAddGroup
  letI : UniformSpace Y := IsTopologicalAddGroup.rightUniformSpace Y
  letI : IsUniformAddGroup Y := isUniformAddGroup_of_addCommGroup
  let D := localBanachDiagonal hp
  let V := D.range
  letI : IsUniformAddGroup V := IsUniformInducing.isUniformAddGroup V.subtype
    isUniformEmbedding_subtype_val.isUniformInducing
  have hD : IsEmbedding D := (localBanachDiagonal_isInducing hp).isEmbedding
  let e := LinearEquiv.ofInjective D.toLinearMap hD.injective
  have hE : Continuous e.symm := hD.isInducing.continuous_iff.mpr
    (continuous_subtype_val.congr fun x => (congrArg Subtype.val (e.apply_symm_apply x)).symm)
  let L : Y ≃L[ℂ] V := ⟨e, D.rangeRestrict.continuous, hE⟩
  have hI : IsUniformEmbedding L.symm :=
    AddMonoidHom.isUniformEmbedding_of_isEmbedding (f := L.symm) L.symm.toHomeomorph.isEmbedding
  refine ⟨fun B hB hClosed => hI.isComplete_iff.mp ?_⟩
  exact hQ.quasiComplete (hB.image L.symm.toContinuousLinearMap)
    (L.symm.toHomeomorph.isClosedMap B hClosed)

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- The corrected Euclidean topology from a defining family of target
seminorms uses the weighted Schwartz norms of the local Banach coordinates. -/
abbrev localBanachSchwartz (hp : WithSeminorms p) :=
  schwartzIntoSubmodule (X := X) (localBanachDiagonal hp).range

/-- The Banach-coordinate realization consists of actual functions into Y
whose local Banach components are Schwartz. -/
def localBanachSchwartz_equiv [T0Space Y] (hp : WithSeminorms p) :
    ↥(localBanachSchwartz (X := X) hp) ≃
      {f : X → Y // ∀ i, ∃ g : 𝓢(X, LocalBanach (p i)), ∀ x,
        g x = localBanachDenseMap (p i) (f x)} := by
  let D := localBanachDiagonal hp
  let L := LinearEquiv.ofInjective D.toLinearMap (localBanachDiagonal_isInducing hp).isEmbedding.injective
  apply (schwartzIntoSubmodule_equiv (X := X) D.range).trans
  refine
    { toFun := fun f => ⟨fun x => L.symm (f.val x), fun i => ?_⟩
      invFun := fun f => ⟨fun x => L (f.val x), f.property⟩
      left_inv := fun f => Subtype.ext (funext fun x => L.apply_symm_apply (f.val x))
      right_inv := fun f => Subtype.ext (funext fun x => L.symm_apply_apply (f.val x)) }
  obtain ⟨g, hg⟩ := f.property i
  refine ⟨g, fun x => (hg x).trans ?_⟩
  exact (congrArg (fun z : D.range => z.val i) (L.apply_symm_apply (f.val x))).symm

/-- The corrected Euclidean space is quasi-complete for quasi-complete targets. -/
theorem localBanachSchwartz_quasiComplete [T0Space Y] (hp : WithSeminorms p)
    (hQ : @QuasiCompleteSpace ℂ Y _ (@IsTopologicalAddGroup.rightUniformSpace Y _ _ hp.topologicalAddGroup)
      _ _) : QuasiCompleteSpace ℂ (localBanachSchwartz (X := X) hp) := by
  letI : QuasiCompleteSpace ℂ (localBanachDiagonal hp).range := localBanachDiagonal_range_quasiComplete hp hQ
  exact quasiComplete_schwartzIntoSubmodule _

/-- A complete target gives completeness of the corrected Euclidean space. -/
theorem localBanachSchwartz_complete [T0Space Y] (hp : WithSeminorms p)
    (hc : @CompleteSpace Y (@IsTopologicalAddGroup.rightUniformSpace Y _ _ hp.topologicalAddGroup)) :
    CompleteSpace (localBanachSchwartz (X := X) hp) :=
  completeSpace_schwartzIntoSubmodule _ (localBanachDiagonal_isClosedEmbedding hp hc).isClosed_range

/-- A complete target with a countable defining family gives a Fréchet
space of Schwartz maps for the corrected Euclidean topology. -/
theorem localBanachSchwartz_frechet [Countable I] [T0Space Y] (hp : WithSeminorms p)
    (hc : @CompleteSpace Y (@IsTopologicalAddGroup.rightUniformSpace Y _ _ hp.topologicalAddGroup)) :
    IsFrechetTVS (localBanachSchwartz (X := X) hp) :=
  isFrechetTVS_schwartzIntoSubmodule _ (localBanachDiagonal_isClosedEmbedding hp hc).isClosed_range

end Canonical

end
