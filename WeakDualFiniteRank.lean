import Mathlib.Analysis.Complex.Basic
import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.Topology.Algebra.Module.Spaces.PointwiseConvergenceCLM

open Function Set Topology
open scoped PointwiseConvergenceCLM

namespace Masullo

noncomputable section

variable {E B : Type*} [AddCommGroup E] [Module ℂ E] [TopologicalSpace E]
variable [NormedAddCommGroup B] [NormedSpace ℂ B]

/-- A continuous map from a weak dual to a normed space annihilates
the common kernel of finitely many evaluation maps. -/
theorem weakDual_map_finite_evaluations (L : (E →Lₚₜ[ℂ] ℂ) →L[ℂ] B) :
    ∃ s : Finset E, ∀ φ : E →Lₚₜ[ℂ] ℂ, (∀ x ∈ s, φ x = 0) → L φ = 0 := by
  classical
  have hp : L ⁻¹' Metric.ball (0 : B) 1 ∈ 𝓝 (0 : E →Lₚₜ[ℂ] ℂ) := by
    apply L.continuous.continuousAt.preimage_mem_nhds
    rw [map_zero]
    exact Metric.ball_mem_nhds _ zero_lt_one
  obtain ⟨⟨S, V⟩, ⟨hS, hV⟩, hsub⟩ := PointwiseConvergenceCLM.hasBasis_nhds_zero.mem_iff.mp hp
  have hSf : S.Finite := hS
  refine ⟨hSf.toFinset, fun φ hφ => ?_⟩
  by_contra h
  let c : ℂ := ((2 / ‖L φ‖ : ℝ) : ℂ)
  have hc : c • φ ∈ {f : E →Lₚₜ[ℂ] ℂ | ∀ x ∈ S, f x ∈ V} := by
    intro x hx
    change c * φ x ∈ V
    rw [hφ x (hSf.mem_toFinset.mpr hx), mul_zero]
    exact mem_of_mem_nhds hV
  have hbound : ‖L (c • φ)‖ < 1 := by simpa [Metric.mem_ball, dist_zero_right] using hsub hc
  have hpos : 0 < ‖L φ‖ := norm_pos_iff.mpr h
  rw [map_smul, norm_smul, show ‖c‖ = 2 / ‖L φ‖ by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (div_pos (by norm_num) hpos)],
    div_mul_cancel₀ _ hpos.ne'] at hbound
  norm_num at hbound

/-- Every continuous linear map from a weak dual to a normed space
has finite-dimensional range. -/
theorem weakDual_map_finiteDimensional_range (L : (E →Lₚₜ[ℂ] ℂ) →L[ℂ] B) :
    FiniteDimensional ℂ L.toLinearMap.range := by
  obtain ⟨s, hs⟩ := weakDual_map_finite_evaluations L
  let ev : (E →Lₚₜ[ℂ] ℂ) →ₗ[ℂ] (s → ℂ) :=
    { toFun := fun φ x => φ x.val
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hk : ev.ker ≤ L.toLinearMap.rangeRestrict.ker := by
    intro φ hφ
    have he : ev φ = 0 := hφ
    apply Subtype.ext
    exact hs φ fun x hx => congrFun he ⟨x, hx⟩
  let e := ev.quotKerEquivRange
  letI : FiniteDimensional ℂ ((E →Lₚₜ[ℂ] ℂ) ⧸ ev.ker) :=
    FiniteDimensional.of_injective e.toLinearMap e.injective
  apply FiniteDimensional.of_surjective (ev.ker.liftQ L.toLinearMap.rangeRestrict hk)
  rintro ⟨b, ⟨φ, rfl⟩⟩
  exact ⟨Submodule.Quotient.mk φ, rfl⟩

/-- In particular a normed space densely generated by the canonical map
from the weak dual is finite-dimensional. -/
theorem weakDual_dense_banach_image_finiteDimensional
    (L : (E →Lₚₜ[ℂ] ℂ) →L[ℂ] B) (h : DenseRange L) : FiniteDimensional ℂ B := by
  letI : FiniteDimensional ℂ L.toLinearMap.range := weakDual_map_finiteDimensional_range L
  have hc : IsClosed (range L) := L.toLinearMap.range.closed_of_finiteDimensional
  have he : range L = univ := hc.closure_eq.symm.trans h.closure_range
  refine FiniteDimensional.of_surjective L.toLinearMap.range.subtype fun x => ⟨⟨x, ?_⟩, rfl⟩
  change x ∈ range L
  rw [he]
  exact mem_univ _

end

end Masullo
