import BruhatCyclicPeriodizationCorollary

open Function Set Topology

namespace Masullo

noncomputable section

variable {G : Type*} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]
  (m : G →ₜ* Multiplicative ℝ)

/-- The logarithmic modulation descends through any subgroup of its
norm-one kernel. -/
def modulatedQuotientMap (K : Subgroup G) (hK : K ≤ m.toMonoidHom.ker) :
    G ⧸ K →ₜ* Multiplicative ℝ :=
  ⟨QuotientGroup.lift K m.toMonoidHom hK,
    (QuotientGroup.isQuotientMap_mk K).continuous_iff.2 m.continuous⟩

omit [IsTopologicalGroup G] in
@[simp] theorem modulatedQuotientMap_mk (K : Subgroup G) (hK : K ≤ m.toMonoidHom.ker) (x : G) :
    modulatedQuotientMap m K hK (QuotientGroup.mk x) = m x := rfl

omit [IsTopologicalGroup G] in
/-- The descended modulation is proper whenever the original one is. -/
theorem modulatedQuotientMap_isProper (K : Subgroup G) (hK : K ≤ m.toMonoidHom.ker)
    (hm : IsProperMap m) :
    IsProperMap (modulatedQuotientMap m K hK) :=
  isProperMap_of_comp_of_surj QuotientGroup.continuous_mk
    (modulatedQuotientMap m K hK).continuous hm QuotientGroup.mk_surjective

omit [IsTopologicalGroup G] in
/-- Surjectivity of the modulation descends through the quotient. -/
theorem modulatedQuotientMap_surjective (K : Subgroup G) (hK : K ≤ m.toMonoidHom.ker)
    (hm : Surjective m) :
    Surjective (modulatedQuotientMap m K hK) := fun y ↦ by
  obtain ⟨x, hx⟩ := hm y
  exact ⟨QuotientGroup.mk x, hx⟩

omit [IsTopologicalGroup G] in
/-- Quotienting first by K and then by the cyclic group agrees with the
quotient by the subgroup generated by K and the generator. -/
theorem cyclicQuotient_thirdIso (K : Subgroup G) (γ : G) :
    ∃ e : ((G ⧸ K) ⧸ Subgroup.zpowers (QuotientGroup.mk γ : G ⧸ K)) ≃ₜ*
      (G ⧸ (K ⊔ Subgroup.zpowers γ)),
      ∀ x : G, e (QuotientGroup.mk (QuotientGroup.mk x : G ⧸ K)) = QuotientGroup.mk x := by
  let q := QuotientGroup.mk' K
  let P := K ⊔ Subgroup.zpowers γ
  let R := Subgroup.zpowers (q γ)
  have hR : P.map q = R := by
    change (K ⊔ Subgroup.zpowers γ).map (QuotientGroup.mk' K) = _
    rw [Subgroup.map_sup, QuotientGroup.map_mk'_self, bot_sup_eq, MonoidHom.map_zpowers]
  let e₀ : ((G ⧸ K) ⧸ R) ≃* (G ⧸ P) :=
    (QuotientGroup.quotientMulEquivOfEq hR.symm).trans
      (QuotientGroup.quotientQuotientEquivQuotient K P le_sup_left)
  let b : G → (G ⧸ K) ⧸ R := fun x ↦ QuotientGroup.mk (q x)
  have hb : IsQuotientMap b :=
    (QuotientGroup.isQuotientMap_mk R).comp (QuotientGroup.isQuotientMap_mk K)
  have h₀ (x : G) : e₀ (b x) = (QuotientGroup.mk x : G ⧸ P) := rfl
  let e : ((G ⧸ K) ⧸ R) ≃ₜ* (G ⧸ P) := e₀.toContinuousMulEquiv fun U ↦ by
    rw [← hb.isCoinducing.isOpen_preimage, preimage_preimage,
      show (fun x ↦ e₀ (b x)) = (QuotientGroup.mk : G → G ⧸ P) from funext h₀]
    exact (QuotientGroup.isQuotientMap_mk P).isCoinducing.isOpen_preimage
  exact ⟨e, h₀⟩

variable [T2Space G]

/-- The subgroup generated by a compact norm-one subgroup and an element
of positive logarithmic modulus is closed. -/
theorem modulatedCompactCyclicSubgroup_isClosed (K : Subgroup G)
    (hK : IsCompact (K : Set G)) (hKm : K ≤ m.toMonoidHom.ker)
    (γ : G) (hγ : 0 < (m γ).toAdd) :
    IsClosed (↑(K ⊔ Subgroup.zpowers γ) : Set G) := by
  letI : IsClosed (K : Set G) := hK.isClosed
  let q : G → G ⧸ K := QuotientGroup.mk
  have hΓ : IsClosed (Subgroup.zpowers (q γ) : Set (G ⧸ K)) :=
    modulatedCyclicSubgroup_isClosed (modulatedQuotientMap m K hKm) (q γ) hγ
  obtain ⟨e, he⟩ := cyclicQuotient_thirdIso K γ
  letI : IsClosed (Subgroup.zpowers (q γ) : Set (G ⧸ K)) := hΓ
  let r : G → (G ⧸ K) ⧸ Subgroup.zpowers (q γ) := QuotientGroup.mk ∘ q
  have hr : Continuous r := QuotientGroup.continuous_mk.comp QuotientGroup.continuous_mk
  have hEq : (↑(K ⊔ Subgroup.zpowers γ) : Set G) = r ⁻¹' {1} := by
    ext x
    change x ∈ K ⊔ Subgroup.zpowers γ ↔ r x = 1
    rw [← e.injective.eq_iff, map_one, show e (r x) = QuotientGroup.mk x from he x,
      QuotientGroup.eq_one_iff]
  rw [hEq]
  exact isClosed_singleton.preimage hr

omit [IsTopologicalGroup G] [T2Space G] in
/-- The quotient by the compact kernel subgroup and the period is compact. -/
theorem modulatedCompactCyclicQuotient_compact (K : Subgroup G)
    (hKm : K ≤ m.toMonoidHom.ker) (hm : IsProperMap m)
    (γ : G) (hγ : 0 < (m γ).toAdd) :
    CompactSpace (G ⧸ (K ⊔ Subgroup.zpowers γ)) := by
  obtain ⟨e, _⟩ := cyclicQuotient_thirdIso K γ
  letI : CompactSpace ((G ⧸ K) ⧸ Subgroup.zpowers (QuotientGroup.mk γ : G ⧸ K)) :=
    modulatedCyclicQuotient_compact (modulatedQuotientMap m K hKm)
      (modulatedQuotientMap_isProper m K hKm hm) (QuotientGroup.mk γ) hγ
  refine ⟨?_⟩
  rw [← image_univ_of_surjective e.surjective]
  exact isCompact_univ.image e.continuous

/-- For a split modulation, compact generation of a compact norm-one
subgroup's annihilator in the norm-one dual implies compact generation in
the full dual. The remaining real-frequency subgroup is connected. -/
theorem modulatedAnnihilator_compactlyGenerated [LocallyCompactSpace G]
    (τ : Multiplicative ℝ →ₜ* G) (hτ : ∀ t, m (τ t) = t)
    (K : Subgroup G) (hK : IsCompact (K : Set G)) (hKm : K ≤ m.toMonoidHom.ker)
    (hgen : IsCompactlyGeneratedGroup
      (lcaAnnihilator (K.comap m.toMonoidHom.ker.subtype))) :
    IsCompactlyGeneratedGroup (lcaAnnihilator K) := by
  have hk : IsClosed (m.toMonoidHom.ker : Set G) :=
    isClosed_singleton.preimage m.continuous
  letI : LocallyCompactSpace m.toMonoidHom.ker := hk.locallyCompactSpace
  let A := lcaAnnihilator K
  let A₁ := lcaAnnihilator (K.comap m.toMonoidHom.ker.subtype)
  have ho : IsOpen (A : Set (PontryaginDual G)) := isOpen_lcaAnnihilator K hK
  letI : LocallyCompactSpace A := ho.isOpenEmbedding_subtypeVal.locallyCompactSpace
  let e : PontryaginDual m.toMonoidHom.ker → PontryaginDual G := extendModulatedCharacter m τ hτ
  have he (ω : A₁) : (e ω.val : PontryaginDual G) ∈ A := by
    apply (mem_lcaAnnihilator_iff K (e ω.val)).2
    intro k
    let k₁ : m.toMonoidHom.ker := ⟨k.val, hKm k.property⟩
    have hv := DFunLike.congr_fun (extendModulatedCharacter_restrict m τ hτ ω.val) k₁
    exact hv.trans ((mem_lcaAnnihilator_iff _ _).1 ω.property ⟨k₁, k.property⟩)
  let E : A₁ →* A :=
    { toFun := fun ω ↦ ⟨e ω.val, he ω⟩
      map_one' := Subtype.ext (ContinuousMonoidHom.ext fun _ ↦ rfl)
      map_mul' := fun _ _ ↦ Subtype.ext (ContinuousMonoidHom.ext fun _ ↦ rfl) }
  have hE : Continuous E := by
    have hec : Continuous e := continuous_extendModulatedCharacter m τ hτ
    exact (hec.comp (continuous_subtype_val : Continuous (Subtype.val : A₁ → _))).subtype_mk he
  have hfreq (t : ℝ) : (modulusCharacter m t : PontryaginDual G) ∈ A := by
    apply (mem_lcaAnnihilator_iff K (modulusCharacter m t)).2
    intro k
    change Circle.exp (t * (m k.val).toAdd) = 1
    have hk : m k.val = 1 := hKm k.property
    rw [hk, toAdd_one, mul_zero, Circle.exp_zero]
  let F (t : ℝ) : A := ⟨modulusCharacter m t, hfreq t⟩
  have hF : Continuous F := by
    apply Continuous.subtype_mk
    apply ContinuousMonoidHom.continuous_of_continuous_uncurry
    exact Circle.exp.continuous.comp
      (continuous_fst.mul (continuous_toAdd.comp (m.continuous.comp continuous_snd)))
  obtain ⟨C, _, hC, hCgen⟩ := hgen
  obtain ⟨D, hD⟩ := exists_openCompactlyGeneratedSubgroup_contains (hC.image hE)
  have hE' (ω : A₁) : E ω ∈ D.val := by
    have hmap : Subgroup.map E ⊤ ≤ D.val := by
      rw [← hCgen, MonoidHom.map_closure]
      exact (Subgroup.closure_le _).2 hD
    exact hmap ⟨ω, Subgroup.mem_top _, rfl⟩
  have hF' (t : ℝ) : F t ∈ D.val := by
    have h₀ : F 0 = 1 := by
      apply Subtype.ext
      exact ContinuousMonoidHom.ext fun x ↦ by
        change Circle.exp (0 * (m x).toAdd) = 1
        rw [zero_mul, Circle.exp_zero]
    have hsub := (isPreconnected_range hF).subset_isClopen
      ⟨D.val.isClosed_of_isOpen D.property.1, D.property.1⟩
      ⟨1, ⟨0, h₀⟩, D.val.one_mem⟩
    exact hsub ⟨t, rfl⟩
  have hDtop : D.val = ⊤ := top_unique fun χ _ ↦ by
    let r := modulatedKernelInclusion m
    let ω₀ : PontryaginDual m.toMonoidHom.ker := (χ.val : CircleCharacter G).comp r
    let ω : A₁ := ⟨ω₀, (mem_lcaAnnihilator_iff (K.comap m.toMonoidHom.ker.subtype) ω₀).2
      fun k ↦ (mem_lcaAnnihilator_iff _ _).1 χ.property ⟨k.val.val, k.property⟩⟩
    obtain ⟨t, ht⟩ := modulatedCharacter_eq_mul_modulus m τ hτ (e ω.val) χ.val
      (extendModulatedCharacter_restrict m τ hτ ω.val).symm
    have hχ : χ = E ω * F t := Subtype.ext ht
    exact hχ.symm ▸ D.val.mul_mem (hE' ω) (hF' t)
  let eTop : (⊤ : Subgroup A) ≃ₜ* A :=
    ⟨Subgroup.topEquiv, continuous_subtype_val, continuous_id.subtype_mk _⟩
  exact compactGeneration_transport eTop (hDtop ▸ D.property.2)

end

end Masullo
