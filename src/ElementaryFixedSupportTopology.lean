open Function Set Topology
open scoped ENNReal

namespace Masullo

noncomputable section

section Elementary

variable {m n r : ℕ} {F : Type*}
  [AddCommGroup F] [TopologicalSpace F] [DiscreteTopology F] [Finite F]

local notation "A" => ElementaryLCAModel m n r F
local notation "X" => EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin n)
local notation "E" => ElementarySchwartz m n r F

/-- On a fixed compact support, each monomial-weighted seminorm is bounded
by the uniform seminorm for the same mixed derivative. -/
theorem elementarySchwartz_weighted_le_uniform_of_support (C : Set A) (hC : IsCompact C)
    (α : Fin m → ℕ) (β : Fin m → ℕ) (γ : Fin n → ℕ) (δ : Fin r → ℕ) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ f : E, support f.val ⊆ C →
      elementarySchwartzSeminorm (α, β, γ, δ) f ≤
        D * elementarySchwartzSeminorm (0, β, γ, 0) f := by
  let w (y : A) : ℂ :=
    (∏ i, (y.1 i : ℂ) ^ α i) * (∏ i, (y.2.2.1 i : ℂ) ^ δ i)
  have hw : Continuous w :=
    (continuous_finsetProd _ fun i _ => ((Complex.continuous_ofReal.comp
      ((PiLp.continuous_apply 2 _ i).comp continuous_fst)).pow _)).mul
      ((continuous_of_discreteTopology (f := fun a : Fin r → ℤ =>
        ∏ i, (a i : ℂ) ^ δ i)).comp (continuous_fst.comp (continuous_snd.comp continuous_snd)))
  obtain ⟨D, hD⟩ := hC.exists_bound_of_continuousOn hw.continuousOn
  refine ⟨max D 0, le_max_right _ _, fun f hf => ?_⟩
  have hle : elementarySchwartzBound f.val (α, β, γ, δ) ≤
      ENNReal.ofReal (max D 0 * elementarySchwartzSeminorm (0, β, γ, 0) f) := by
    refine iSup_le fun xt => iSup_le fun a => iSup_le fun b => ?_
    change (‖w (elementaryCover xt a b) * elementaryPartial f.val β γ xt a b‖₊ : ℝ≥0∞) ≤ _
    rw [← ENNReal.ofReal_coe_nnreal]
    apply ENNReal.ofReal_le_ofReal
    change ‖w (elementaryCover xt a b) * elementaryPartial f.val β γ xt a b‖ ≤ _
    by_cases hx : elementaryCover xt a b ∈ C
    · rw [norm_mul]
      exact mul_le_mul ((hD _ hx).trans (le_max_left _ _))
        (zero_monomial_partial_le β γ f xt a b) (norm_nonneg _) (le_max_right _ _)
    · have hcq : Continuous (fun v : X => elementaryCover v a b) :=
        elementaryCover_openQuotientMap.continuous.comp
          (continuous_id.prodMk (continuous_const (y := (a, b))))
      have hu : xt ∉ tsupport (fun v : X => f.val (elementaryCover v a b)) := by
        intro h
        exact hx (closure_minimal hf hC.isClosed (tsupport_comp_subset_preimage f.val hcq h))
      have h0 (j : ℕ) : iteratedFDeriv ℝ j (fun v : X => f.val (elementaryCover v a b)) xt = 0 :=
        image_eq_zero_of_notMem_tsupport (fun h => hu (tsupport_iteratedFDeriv_subset j h))
      have hz : elementaryPartial f.val β γ xt a b = 0 := by
        rw [elementaryPartial_eq_basis, h0]
        rfl
      rw [hz, mul_zero, norm_zero]
      exact mul_nonneg (le_max_right _ _) (apply_nonneg _ _)
  exact (ENNReal.toReal_mono ENNReal.ofReal_lt_top.ne hle).trans_eq
    (ENNReal.toReal_ofReal (mul_nonneg (le_max_right _ _) (apply_nonneg _ _)))

/-- The fixed-support topology is generated by uniform convergence of
the mixed derivatives, including the function at derivative order zero. -/
theorem elementarySchwartz_fixedSupport_withUniformSeminorms
    (C : Set A) (hC : IsCompact C) (S : Submodule ℂ E)
    (hS : ∀ f : S, support f.val.val ⊆ C) :
    WithSeminorms (fun i : (Fin m → ℕ) × (Fin n → ℕ) =>
      (elementarySchwartzSeminorm (0, i.1, i.2, 0)).comp S.subtype) := by
  let p : SeminormFamily ℂ S (ElementarySchwartzIndex m n r) :=
    fun i => (elementarySchwartzSeminorm (F := F) i).comp S.subtype
  let q : SeminormFamily ℂ S ((Fin m → ℕ) × (Fin n → ℕ)) :=
    fun i => (elementarySchwartzSeminorm (0, i.1, i.2, 0)).comp S.subtype
  have hp : WithSeminorms p :=
    (IsInducing.subtypeVal (t := (S : Set E))).withSeminorms
      (f := S.subtype) elementarySchwartz_withSeminorms
  refine hp.congr (Seminorm.IsBounded.of_real (f := LinearMap.id) ?_)
    (Seminorm.IsBounded.of_real (f := LinearMap.id) ?_)
  · intro i
    refine ⟨{(0, i.1, i.2, 0)}, 1, fun f => ?_⟩
    rw [Finset.sup_singleton, one_mul]
    exact le_rfl
  · rintro ⟨α, β, γ, δ⟩
    obtain ⟨D, _, hD⟩ := elementarySchwartz_weighted_le_uniform_of_support C hC α β γ δ
    refine ⟨{(β, γ)}, D, fun f => ?_⟩
    rw [Finset.sup_singleton]
    exact hD f.val (hS f)

set_option maxHeartbeats 2000000 in
/-- Uniform seminorms for the mixed partials control the derivative along
any fixed list of tangent directions on each covering fibre. -/
theorem elementarySchwartz_iteratedFDeriv_directions_le (k : ℕ) (v : Fin k → X) :
    ∃ (s : Finset ((Fin m → ℕ) × (Fin n → ℕ))) (D : ℝ), 0 ≤ D ∧
      ∀ (f : E) (x : X) (a : Fin r → ℤ) (b : F),
        ‖iteratedFDeriv ℝ k (fun z ↦ f.val (elementaryCover z a b)) x v‖ ≤
          D * (s.sup (fun i ↦ elementarySchwartzSeminorm (0, i.1, i.2, 0))) f := by
  classical
  let B := elementaryFibreBasis m n
  let J := Fin k → Fin m ⊕ Fin n
  let i₀ (t : J) := (elementaryIteratedFDeriv_basis (r := r) (F := F) t).choose
  let i₁ (t : J) := ((elementaryIteratedFDeriv_basis (r := r) (F := F) t).choose_spec).choose
  let ind (t : J) := (i₀ t, i₁ t)
  let c (t : J) : ℝ := ∏ j, B.repr (v j) (t j)
  let s := Finset.univ.image ind
  let p : SeminormFamily ℂ E ((Fin m → ℕ) × (Fin n → ℕ)) :=
    fun i ↦ elementarySchwartzSeminorm (0, i.1, i.2, 0)
  refine ⟨s, ∑ t : J, ‖c t‖, Finset.sum_nonneg (fun _ _ ↦ norm_nonneg _), fun f x a b ↦ ?_⟩
  let D := iteratedFDeriv ℝ k (fun z ↦ f.val (elementaryCover z a b)) x
  have hD (t : J) : D (fun j ↦ B (t j)) = elementaryPartial f.val (i₀ t) (i₁ t) x a b :=
    ((elementaryIteratedFDeriv_basis (r := r) (F := F) t).choose_spec).choose_spec f.val a b
      (f.property.1 a b) x
  have hsum : D v = ∑ t : J, c t • elementaryPartial f.val (i₀ t) (i₁ t) x a b := by
    change D.toMultilinearMap v = _
    conv_lhs => rw [show v = (fun j ↦ ∑ i, B.repr (v j) i • B i) from
      funext fun j ↦ (B.sum_repr (v j)).symm]
    rw [D.toMultilinearMap.map_sum]
    simp_rw [D.toMultilinearMap.map_smul_univ, ContinuousMultilinearMap.coe_coe, hD, c]
    rfl
  change ‖D v‖ ≤ (∑ t : J, ‖c t‖) * (s.sup p) f
  rw [hsum, Finset.sum_mul]
  have hle (t : J) : ‖elementaryPartial f.val (i₀ t) (i₁ t) x a b‖ ≤ (s.sup p) f := by
    have hs : p (ind t) ≤ s.sup p := Finset.le_sup (Finset.mem_image_of_mem ind (Finset.mem_univ t))
    have hs' : p (ind t) f ≤ (s.sup p) f := hs f
    exact (zero_monomial_partial_le (i₀ t) (i₁ t) f x a b).trans hs'
  have hmul (t : J) : ‖c t • elementaryPartial f.val (i₀ t) (i₁ t) x a b‖ ≤
      ‖c t‖ * (s.sup p) f :=
    (norm_smul _ _).le.trans (mul_le_mul_of_nonneg_left (hle t) (norm_nonneg _))
  exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun t _ ↦ hmul t)

end Elementary

variable {G : Type*} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]
  [T2Space G] [LocallyCompactSpace G]

omit [T2Space G] [LocallyCompactSpace G] in
/-- The whole-group coordinates identify the actual kernel quotient with
the elementary model and commute with the quotient map. -/
theorem WholeBruhatStage.exists_quotientCoordinates (P : WholeBruhatStage G)
    (K : Subgroup G) (hK : P.val.1.kernel = K) :
    ∃ e : G ⧸ K ≃ₜ* Multiplicative (ElementaryLCAModel P.val.2.realDim P.val.2.torusDim
      P.val.2.latticeRank P.val.2.finiteFactor),
      ∀ x : G, e (QuotientGroup.mk x) = P.coordinates x := by
  have hk := P.coordinates_ker.trans hK
  let e₀ := (QuotientGroup.quotientMulEquivOfEq hk.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective P.coordinates.toMonoidHom P.coordinates_surjective)
  have hq := QuotientGroup.isQuotientMap_mk K
  have hc := P.coordinates_isOpenMap.isQuotientMap P.coordinates.continuous P.coordinates_surjective
  refine ⟨e₀.toContinuousMulEquiv fun U ↦ ?_, fun _ ↦ rfl⟩
  exact hq.isCoinducing.isOpen_preimage.symm.trans hc.isCoinducing.isOpen_preimage

/-- On the fixed stage of invariant tests with compact support, the stage
topology is uniform convergence of derivatives on the compact image of
the support in the elementary quotient. -/
theorem WholeBruhatStage.compactTests_withUniformSeminorms
    (P : WholeBruhatStage G) (C : Set G) (hC : IsCompact C) :
    WithSeminorms (fun i : (Fin P.val.2.realDim → ℕ) × (Fin P.val.2.torusDim → ℕ) =>
      (elementarySchwartzSeminorm (0, i.1, i.2, 0)).comp (P.val.compactTests C).subtype) := by
  let q := fun x : G ↦ (P.coordinates x).toAdd
  have hc : IsCompact (q '' C) := hC.image (continuous_toAdd.comp P.coordinates.continuous)
  apply elementarySchwartz_fixedSupport_withUniformSeminorms (q '' C) hc
  intro f y hy
  obtain ⟨x, hx⟩ := P.coordinates_surjective (Multiplicative.ofAdd y)
  have hxy : q x = y := congrArg Multiplicative.toAdd hx
  refine ⟨x, ?_, hxy⟩
  by_contra hn
  have hz := f.property x hn
  rw [P.realize_eq_coordinates] at hz
  change f.val.val (q x) = 0 at hz
  exact hy (hxy ▸ hz)

end

end Masullo
