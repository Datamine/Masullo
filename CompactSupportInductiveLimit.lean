/-- Compactly supported maps are dense for the compact-open topology when the target
admits a continuous real scalar action with zero. -/
theorem denseRange_toContinuousMap_of_real_smul {X E : Type*} [TopologicalSpace X]
    [R1Space X] [LocallyCompactSpace X] [Zero E] [TopologicalSpace E]
    [MulActionWithZero ℝ E] [ContinuousSMul ℝ E] :
    DenseRange (CompactlySupportedContinuousMap.toContinuousMap : C_c(X, E) → C(X, E)) := by
  intro f
  have approx (K : Compacts X) : ∃ g : C_c(X, E), EqOn g f K := by
    obtain ⟨φ, hφ, hcomp, _, _⟩ :=
      exists_continuousMap_one_of_isCompact_subset_isOpen K.isCompact isOpen_univ (subset_univ _)
    refine ⟨⟨⟨fun x ↦ φ x • f x, φ.continuous.smul f.continuous⟩,
      (show HasCompactSupport (φ : X → ℝ) from hcomp).smul_right⟩, ?_⟩
    intro x hx
    change φ x • f x = f x
    rw [hφ hx, Pi.one_apply, one_smul]
  choose g hg using approx
  apply mem_closure_of_tendsto (f := fun K ↦ (g K).toContinuousMap) (b := atTop)
  · apply ContinuousMap.tendsto_nhds_compactOpen.mpr
    intro L hL U _ hU
    filter_upwards [eventually_ge_atTop (⟨L, hL⟩ : Compacts X)] with K hLK x hx
    change g K x ∈ U
    rw [hg K (hLK hx)]
    exact hU hx
  · exact Eventually.of_forall fun K ↦ mem_range_self (g K)


open scoped ComplexOrder in
/-- The compact-open topology on continuous maps into a real or complex polynormable space
is generated by continuous seminorms. -/
theorem polynormableSpace_continuousMap (𝕜 X E : Type*) [RCLike 𝕜] [TopologicalSpace X]
    [AddCommGroup E] [Module 𝕜 E] [TopologicalSpace E] [IsTopologicalAddGroup E]
    [ContinuousSMul 𝕜 E]
    [PolynormableSpace 𝕜 E] : PolynormableSpace 𝕜 C(X, E) := by
  let : Module ℝ E := Module.restrictScalars ℝ 𝕜 E
  let : IsScalarTower ℝ 𝕜 E := IsScalarTower.restrictScalars ℝ 𝕜 E
  let : ContinuousSMul ℝ E := IsScalarTower.continuousSMul 𝕜
  let : LocallyConvexSpace ℝ E := (PolynormableSpace.withSeminorms 𝕜 E).toLocallyConvexSpace
  let : LocallyConvexSpace 𝕜 E := LocallyConvexSpace.ofBasisZero 𝕜 E id _
    (LocallyConvexSpace.convex_basis_zero ℝ E)
    (fun _ h ↦ convex_RCLike_iff_convex_real.mpr h.2)
  infer_instance


/-- A family of maps on a disjoint union is continuous in the compact-open topology
when its restriction to each component varies continuously. -/
theorem continuous_continuousMap_sigma_of_components {A I E : Type*} {Y : I → Type*}
    [TopologicalSpace A] [∀ i, TopologicalSpace (Y i)] [TopologicalSpace E]
    (g : A → C((Σ i, Y i), E)) (h : ∀ i, Continuous (fun a ↦ (g a).comp
      (⟨Sigma.mk i, continuous_sigmaMk⟩ : C(Y i, (Σ j, Y j))))) : Continuous g := by
  apply ContinuousMap.continuous_compactOpen.mpr
  intro K hK U hU
  obtain ⟨s, t, hs, ht, rfl⟩ := hK.sigma_exists_finite_sigma_eq
  have heq : {a | MapsTo (g a) (s.sigma t) U} =
      ⋂ i ∈ s, {a | MapsTo (fun y ↦ g a ⟨i, y⟩) (t i) U} := by
    ext a
    simp only [mem_ofPred_eq, mem_iInter]
    exact ⟨fun ha i hi y hy ↦ ha ⟨hi, hy⟩, fun ha ⟨i, y⟩ hiy ↦ ha i hiy.1 hiy.2⟩
  rw [heq]
  exact hs.isOpen_biInter fun i _ ↦ (ContinuousMap.isOpen_setOfPred_mapsTo (ht i) hU).preimage (h i)

/-- Restriction to the components of a disjoint union identifies its compactly supported
continuous maps with finitely supported families of compactly supported continuous maps. -/
theorem exists_compactSupport_sigma_linearEquiv (R : Type*) [Semiring R] {I : Type*}
    (Y : I → Type*) [∀ i, TopologicalSpace (Y i)] [∀ i, T2Space (Y i)]
    (E : Type*) [AddCommMonoid E] [Module R E] [TopologicalSpace E] [ContinuousAdd E]
    [ContinuousConstSMul R E] :
    ∃ e : C_c((Σ i, Y i), E) ≃ₗ[R] (⨁ i, C_c(Y i, E)), ∀ f i y, e f i y = f ⟨i, y⟩ := by
  classical
  let assemble : (⨁ i, C_c(Y i, E)) →ₗ[R] C_c((Σ i, Y i), E) :=
    { toFun := fun g ↦
        { toFun := fun x ↦ g x.1 x.2
          continuous_toFun := continuous_sigma fun i ↦ (g i).continuous
          hasCompactSupport' := by
            let K := (g.support : Set I).sigma (fun i ↦ tsupport (g i : Y i → E))
            have hK : IsCompact K := Set.isCompact_sigma (Finset.finite_toSet _)
              (fun i _ ↦ (g i).hasCompactSupport)
            apply hK.of_isClosed_subset (isClosed_tsupport _) (closure_minimal _ hK.isClosed)
            rintro ⟨i, y⟩ hy
            exact ⟨DFinsupp.mem_support_iff.mpr (fun h ↦ hy (by simp [h])),
              subset_closure hy⟩ }
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hinj : Injective assemble := by
    intro g h he
    exact DFinsupp.ext fun i ↦ DFunLike.ext _ _ fun y ↦
      congrArg (fun f : C_c((Σ i, Y i), E) ↦ f ⟨i, y⟩) he
  have hsurj : Surjective assemble := by
    intro f
    let restrict (i : I) := f.comp (⟨⟨Sigma.mk i, continuous_sigmaMk⟩,
      IsClosedEmbedding.sigmaMk.tendsto_cocompact⟩ : CocompactMap (Y i) (Σ j, Y j))
    obtain ⟨s, t, hs, _, hst⟩ := f.hasCompactSupport.sigma_exists_finite_sigma_eq
    let g : ⨁ i, C_c(Y i, E) := DFinsupp.mk hs.toFinset (fun i ↦ restrict i)
    refine ⟨g, DFunLike.ext _ _ fun ⟨i, y⟩ ↦ ?_⟩
    change g i y = f ⟨i, y⟩
    by_cases hi : i ∈ hs.toFinset
    · rw [show g i = restrict i from DFinsupp.mk_of_mem hi]
      rfl
    · rw [show g i = 0 from DFinsupp.mk_of_notMem hi]
      refine (image_eq_zero_of_notMem_tsupport ?_).symm
      intro hy
      rw [← hst] at hy
      exact hi (hs.mem_toFinset.mpr hy.1)
  let e := LinearEquiv.ofBijective assemble ⟨hinj, hsurj⟩
  exact ⟨e.symm, fun f i y ↦ congrArg (fun g : C_c((Σ i, Y i), E) ↦ g ⟨i, y⟩)
    (e.apply_symm_apply f)⟩


/-- A disjoint union of locally compact spaces is locally compact. -/
instance locallyCompactSpace_sigma {I : Type*} (Y : I → Type*) [∀ i, TopologicalSpace (Y i)]
    [∀ i, LocallyCompactSpace (Y i)] : LocallyCompactSpace (Σ i, Y i) where
  local_compact_nhds := by
    rintro ⟨i, y⟩ U hU
    obtain ⟨K, hKy, hKU, hK⟩ := local_compact_nhds
      ((continuous_sigmaMk (i := i)).continuousAt hU)
    exact ⟨Sigma.mk i '' K, isOpenMap_sigmaMk.image_mem_nhds hKy,
      image_subset_iff.mpr hKU, hK.image continuous_sigmaMk⟩


/-- A set contained in no compact set in a paracompact space with compact neighborhoods
contains a sequence visiting each compact set only finitely often. -/
theorem exists_seq_finite_preimage_of_not_subset_compact {X : Type*} [TopologicalSpace X]
    [WeaklyLocallyCompactSpace X] [ParacompactSpace X] {S : Set X}
    (hS : ∀ K : Set X, IsCompact K → ¬ S ⊆ K) :
    ∃ x : ℕ → X, (∀ n, x n ∈ S) ∧ ∀ K : Set X, IsCompact K → (x ⁻¹' K).Finite := by
  classical
  choose K hK hxK using fun x : X ↦ exists_compact_mem_nhds x
  obtain ⟨V, _, hcover, hloc, hVK⟩ :=
    precise_refinement (fun x ↦ interior (K x)) (fun _ ↦ isOpen_interior)
      (iUnion_eq_univ_iff.mpr fun x ↦ ⟨x, mem_interior_iff_mem_nhds.mpr (hxK x)⟩)
  let I := {i | (V i ∩ S).Nonempty}
  have hI : I.Infinite := by
    intro hfin
    apply hS (⋃ i ∈ I, K i) (hfin.isCompact_biUnion fun i _ ↦ hK i)
    intro y hy
    obtain ⟨i, hiy⟩ := iUnion_eq_univ_iff.mp hcover y
    exact mem_iUnion₂.mpr ⟨i, ⟨y, hiy, hy⟩, interior_subset (hVK i hiy)⟩
  let e := hI.natEmbedding I
  choose x hxV hxS using fun n : ℕ ↦ (e n).property
  refine ⟨x, hxS, fun L hL ↦ ?_⟩
  have hloc' := hloc.comp_injective (Subtype.val_injective.comp e.injective)
  exact (hloc'.finite_nonempty_inter_compact hL).subset fun n hn ↦ ⟨x n, hxV n, hn⟩


/-- The uniform structure of compact convergence makes the continuous maps into a
uniform additive group whenever their target is one. -/
theorem isUniformAddGroup_continuousMap (X E : Type*) [TopologicalSpace X]
    [AddGroup E] [UniformSpace E] [IsUniformAddGroup E] : IsUniformAddGroup C(X, E) := by
  let includeMap : C(X, E) →+ UniformOnFun X E {K | IsCompact K} :=
    { toFun := ContinuousMap.toUniformOnFunIsCompact
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  exact IsUniformInducing.isUniformAddGroup includeMap
    ContinuousMap.isUniformEmbedding_toUniformOnFunIsCompact.isUniformInducing

/-- A closed set of continuous maps is complete for compact convergence if the closure
of its image under evaluation at each point is complete. -/
theorem isComplete_continuousMap_of_isComplete_eval
    {X E : Type*} [TopologicalSpace X] [CompactlyCoherentSpace X] [UniformSpace E]
    {s : Set C(X, E)} (hs : IsClosed s)
    (heval : ∀ x : X, IsComplete (closure ((fun f : C(X, E) ↦ f x) '' s))) :
    IsComplete s := by
  let j : C(E, Completion E) := ⟨(↑), Completion.continuous_coe E⟩
  have hj : IsUniformInducing j := Completion.isUniformInducing_coe E
  let J : C(X, E) → C(X, Completion E) := j.comp
  have hJ : IsUniformInducing J := ContinuousMap.isUniformInducing_comp j hj
  apply hJ.isComplete_iff.mp
  apply IsClosed.isComplete
  rw [← closure_subset_iff_isClosed]
  intro f hf
  -- Point evaluations of a limit still lie in the image of the original target.
  have lifts (x : X) : ∃ y : E, j y = f x := by
    let A := closure ((fun g : C(X, E) ↦ g x) '' s)
    have hA : IsClosed (j '' A) := (hj.isComplete_iff.mpr (heval x)).isClosed
    have hx : f x ∈ j '' A := by
      apply closure_minimal (t := (fun g : C(X, Completion E) ↦ g x) ⁻¹' (j '' A))
        _ (hA.preimage (continuous_eval_const x)) hf
      rintro _ ⟨g, hg, rfl⟩
      exact ⟨g x, subset_closure ⟨g, hg, rfl⟩, rfl⟩
    obtain ⟨y, _, hy⟩ := hx
    exact ⟨y, hy⟩
  choose g hg using lifts
  let G : C(X, E) := ⟨g, hj.isInducing.continuous_iff.mpr (by
    convert f.continuous using 1
    exact funext hg)⟩
  have hG : J G = f := ContinuousMap.ext hg
  refine ⟨G, ?_, hG⟩
  rw [← hs.closure_eq, hJ.isInducing.closure_eq_preimage_closure_image]
  change J G ∈ closure (J '' s)
  rwa [hG]


section DirectSumSeminorm

variable {𝕜 ι : Type*} {X : ι → Type*}
  [NormedField 𝕜] [∀ i, AddCommGroup (X i)] [∀ i, Module 𝕜 (X i)]
  [DecidableEq ι] [∀ (i : ι) (z : X i), Decidable (z ≠ 0)]

/-- The sum of the coordinate seminorms on a direct sum, evaluated using finite support. -/
def directSumSeminorm (p : ∀ i, Seminorm 𝕜 (X i)) : Seminorm 𝕜 (⨁ i, X i) := by
  refine Seminorm.of (fun x ↦ x.sum fun i ↦ p i) (fun x y ↦ ?_) (fun a x ↦ ?_)
  · rw [DFinsupp.sum_of_support_subset DFinsupp.support_add (fun i _ ↦ map_zero (p i)),
      DFinsupp.sum_of_support_subset Finset.subset_union_left (fun i _ ↦ map_zero (p i)),
      DFinsupp.sum_of_support_subset Finset.subset_union_right (fun i _ ↦ map_zero (p i)),
      ← Finset.sum_add_distrib]
    exact Finset.sum_le_sum fun i _ ↦ map_add_le_add (p i) (x i) (y i)
  · rw [DFinsupp.sum_of_support_subset (DFinsupp.support_smul a x) (fun i _ ↦ map_zero (p i))]
    simp only [DFinsupp.smul_apply, map_smul_eq_mul, Finset.mul_sum, DFinsupp.sum]

/-- The seminorm sum can be evaluated over any finite set containing the support. -/
theorem directSumSeminorm_apply (p : ∀ i, Seminorm 𝕜 (X i)) (x : ⨁ i, X i) (s : Finset ι)
    (hs : x.support ⊆ s) :
    directSumSeminorm p x = ∑ i ∈ s, p i (x i) := by
  exact DFinsupp.sum_of_support_subset hs fun i _ ↦ map_zero (p i)

/-- On a single summand the seminorm sum restricts to the corresponding seminorm. -/
@[simp]
theorem directSumSeminorm_lof (p : ∀ i, Seminorm 𝕜 (X i)) (i : ι) (x : X i) :
    directSumSeminorm p (DirectSum.lof 𝕜 ι X i x) = p i x := by
  exact DFinsupp.sum_single_index (h := fun i ↦ p i) (map_zero (p i))

/-- Any finite coordinate sum is bounded by the sum over the whole direct sum. -/
theorem sum_le_directSumSeminorm (p : ∀ i, Seminorm 𝕜 (X i)) (x : ⨁ i, X i)
    (s : Finset ι) : (∑ i ∈ s, p i (x i)) ≤ directSumSeminorm p x := by
  rw [directSumSeminorm_apply p x (s ∪ x.support) Finset.subset_union_right]
  exact Finset.sum_le_sum_of_subset_of_nonneg Finset.subset_union_left
    (fun i _ _ ↦ apply_nonneg (p i) (x i))


end DirectSumSeminorm

section CompactSupport

variable {X E : Type*} [TopologicalSpace X] [AddCommGroup E] [Module ℂ E]
  [TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul ℂ E]

-- TODO(paper-gap): The p. 720 preamble infers a continuous one-point extension from
-- boundedness and asserts incompleteness of the scalar compactly supported space for all X.

/-- Paper: Definition C.5.1.1, p. 721. The fixed-support stage consists of compactly
supported continuous maps that vanish off the given compact set. -/
def compactSupportStage (K : Compacts X) : Submodule ℂ C_c(X, E) :=
  ⨅ (x : X) (_ : x ∉ (K : Set X)), LinearMap.ker
    ({ toFun := fun f ↦ f x
       map_add' := fun f g ↦ CompactlySupportedContinuousMap.add_apply x f g
       map_smul' := fun c f ↦ CompactlySupportedContinuousMap.smul_apply c f x } : C_c(X, E) →ₗ[ℂ] E)

/-- Paper: Definition C.5.1.1, p. 721. On a fixed-support stage, uniform convergence
is induced by restriction to the compact set, where the compact-open topology is uniform. -/
@[instance_reducible]
def compactSupportStageTopology (K : Compacts X) :
    TopologicalSpace (compactSupportStage (E := E) K) :=
  TopologicalSpace.induced
    (fun f : compactSupportStage (E := E) K ↦ f.val.toContinuousMap.comp
      (⟨Subtype.val, continuous_subtype_val⟩ : C(↥(K : Set X), X))) inferInstance

/-- Paper: Definition C.5.1.1, p. 721. The topology on compactly supported maps is
the final locally convex topology of the compact support stages with uniform convergence. -/
@[instance_reducible]
def compactSupportLCTopology (X E : Type*) [TopologicalSpace X] [AddCommGroup E] [Module ℂ E]
    [TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul ℂ E] :
    TopologicalSpace C_c(X, E) :=
  letI (K : Compacts X) : TopologicalSpace (compactSupportStage (E := E) K) :=
    compactSupportStageTopology K
  locallyConvexFinalTopology (fun K : Compacts X ↦ (compactSupportStage (E := E) K).subtype)

variable [T2Space X] [LocallyCompactSpace X] [T2Space E] [PolynormableSpace ℂ E]

/-- Paper: Definition C.5.1.1, p. 721. For a compact set in a Hausdorff space, vanishing
off the set is equivalent to having topological support contained in it. -/
theorem mem_compactSupportStage_iff (K : Compacts X) (f : C_c(X, E)) :
    f ∈ compactSupportStage K ↔ tsupport (f : X → E) ⊆ (K : Set X) := by
  rw [tsupport, K.isCompact.isClosed.closure_subset_iff, Function.support_subset_iff']
  simp only [compactSupportStage, Submodule.mem_iInf, LinearMap.mem_ker]
  rfl

/-- Paper: Definition C.5.1.1, p. 721. Whole-space restriction on a compact domain
identifies the fixed-support topology with the topology on continuous maps. -/
theorem compactSupportStageTopology_univ [CompactSpace X] :
    let K : Compacts X := ⟨univ, isCompact_univ⟩
    compactSupportStageTopology (E := E) K =
      TopologicalSpace.induced
        (fun f : compactSupportStage (E := E) K ↦ f.val.toContinuousMap) inferInstance := by
  intro K
  let restrictUniv : C(X, E) ≃ₜ C(↥(univ : Set X), E) :=
    (Homeomorph.Set.univ X).symm.arrowCongr (Homeomorph.refl E)
  change TopologicalSpace.induced
    (restrictUniv ∘ fun f : compactSupportStage (E := E) K ↦ f.val.toContinuousMap) _ = _
  rw [← induced_compose, ← restrictUniv.isInducing.eq_induced]

private theorem isEmbedding_compactSupportStage_toContinuousMap (K : Compacts X) :
    letI := compactSupportStageTopology (E := E) K
    IsEmbedding (fun f : compactSupportStage (E := E) K ↦ f.val.toContinuousMap) := by
  let := compactSupportStageTopology (E := E) K
  let inclusion (f : compactSupportStage (E := E) K) := f.val.toContinuousMap
  have hCont : Continuous inclusion := by
    apply ContinuousMap.continuous_compactOpen.mpr
    intro L hL U hU
    let val : ↥(K : Set X) → X := Subtype.val
    let restrict : compactSupportStage (E := E) K → C(↥(K : Set X), E) :=
      fun f ↦ f.val.toContinuousMap.comp ⟨val, continuous_subtype_val⟩
    have hRestrict : Continuous restrict := continuous_induced_dom
    have hPreimage : IsCompact (val ⁻¹' L) :=
      K.isCompact.isClosed.isClosedEmbedding_subtypeVal.isCompact_preimage hL
    have hZero (f : compactSupportStage (E := E) K) {x : X} (hx : x ∉ (K : Set X)) :
        f.val x = 0 :=
      image_eq_zero_of_notMem_tsupport fun hs ↦
        hx ((mem_compactSupportStage_iff K f.val).mp f.property hs)
    -- Off the supporting set, the compact-open condition only tests the value zero.
    have hMapsTo (f : compactSupportStage (E := E) K) :
        MapsTo (inclusion f) L U ↔
          MapsTo (restrict f) (val ⁻¹' L) U ∧
            ∀ x ∈ L, x ∉ (K : Set X) → (0 : E) ∈ U := by
      constructor
      · intro hf
        refine ⟨fun x hx ↦ hf hx, fun x hx hxK ↦ ?_⟩
        rw [← hZero f hxK]
        exact hf hx
      · rintro ⟨hf, hOutside⟩ x hx
        change f.val x ∈ U
        by_cases hxK : x ∈ (K : Set X)
        · exact hf (show ⟨x, hxK⟩ ∈ val ⁻¹' L from hx)
        · rw [hZero f hxK]
          exact hOutside x hx hxK
    simp_rw [hMapsTo]
    exact ((ContinuousMap.isOpen_setOfPred_mapsTo hPreimage hU).preimage hRestrict).inter
      isOpen_const
  let val : C(↥(K : Set X), X) := ⟨Subtype.val, continuous_subtype_val⟩
  refine ⟨IsInducing.of_comp hCont (ContinuousMap.continuous_precomp val) ⟨rfl⟩, ?_⟩
  intro f g h
  exact Subtype.ext (DFunLike.ext _ _ fun x ↦ congrArg (fun u : C(X, E) ↦ u x) h)

/-- Paper: Definition C.5.1.1, p. 721. For compact X, the inductive limit topology
agrees with the topology induced by the inclusion into continuous maps. -/
theorem compactSupportLCTopology_of_compact [CompactSpace X] :
    compactSupportLCTopology X E =
      TopologicalSpace.induced (CompactlySupportedContinuousMap.toContinuousMap :
        C_c(X, E) → C(X, E)) inferInstance := by
  let inclusion : C_c(X, E) →ₗ[ℂ] C(X, E) :=
    { toFun := CompactlySupportedContinuousMap.toContinuousMap
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  let : TopologicalSpace C_c(X, E) := induced inclusion inferInstance
  let := polynormableSpace_continuousMap ℂ X E
  let : PolynormableSpace ℂ C_c(X, E) := PolynormableSpace.induced inclusion
  let (K : Compacts X) := compactSupportStageTopology (E := E) K
  have hStage (K : Compacts X) : Continuous (compactSupportStage (E := E) K).subtype :=
    continuous_induced_rng.mpr (isEmbedding_compactSupportStage_toContinuousMap (E := E) K).continuous
  -- Every map belongs to the whole-space stage.
  let K : Compacts X := ⟨univ, isCompact_univ⟩
  let lift : C_c(X, E) → compactSupportStage (E := E) K :=
    fun f ↦ ⟨f, (mem_compactSupportStage_iff K f).mpr (subset_univ _)⟩
  have hLift : Continuous lift := by
    change Continuous[_, compactSupportStageTopology (E := E) K] lift
    rw [compactSupportStageTopology_univ]
    exact continuous_induced_rng.mpr continuous_induced_dom
  have hContinuous : (fun p : Seminorm ℂ C_c(X, E) ↦
      ∀ K, Continuous (p ∘ (compactSupportStage (E := E) K).subtype)) =
      (fun p : Seminorm ℂ C_c(X, E) ↦ Continuous p) := by
    funext p
    exact propext ⟨fun hp ↦ (hp K).comp hLift, fun hp K ↦ hp.comp (hStage K)⟩
  change (SeminormFamily.moduleFilterBasis
    (Subtype.val : {p : Seminorm ℂ C_c(X, E) //
      ∀ K, Continuous (p ∘ (compactSupportStage (E := E) K).subtype)} → _)).topology =
    induced inclusion inferInstance
  rw [hContinuous]
  exact (PolynormableSpace.withSeminorms ℂ C_c(X, E)).withSeminorms_eq.symm

